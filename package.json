{
  "name": "odoo-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "create:role-users": "node scripts/create-role-test-users.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.vue --ignore-path .gitignore --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss}\"",
    "andriod:live": "npx.cmd cap run android -l --host localhost --port 5173 --forwardPorts 5173:5173",
    "ios:live": "npx cap run ios -l --host localhost --port 5173"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@supabase/supabase-js": "^2.108.0",
    "@zxing/browser": "^0.2.0",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "supabase": "^2.105.0",
    "terser": "^5.4.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "vue-tsc": "^3.3.4"
  },
  "description": "An Ionic project"
}
